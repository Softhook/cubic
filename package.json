{
  "name": "quantum",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "npm run data && npm run dev -w @quantum/web",
    "dev:https": "npm run data && npm run dev:https -w @quantum/web",
    "build": "npm run data && npm run typecheck && npm run build -w @quantum/web",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p packages/ai && tsc --noEmit -p packages/art && tsc --noEmit -p packages/online && tsc --noEmit -p apps/web && tsc -p tsconfig.test.json",
    "test": "npm run data && vitest run",
    "test:deep": "npm run data && DEEP=1 vitest run consistency",
    "check": "npm run typecheck && npm run lint -- --max-warnings 0 && npm run circular && npm run knip && npm run format:check && npm test",
    "ai:match": "npm run data && vite-node scripts/ai-match.ts",
    "power:usage": "npm run data && vite-node scripts/power-usage.ts --",
    "selfplay:cards": "npm run data && vite-node scripts/selfplay-cards.ts",
    "selfplay:skills": "npm run data && vite-node scripts/skill-ab.ts --",
    "audit:cards": "npm run data && vite-node scripts/card-audit.ts --",
    "sweep:basic": "npm run data && vite-node scripts/basic-sweep.ts",
    "relays:check": "vite-node scripts/relay-check.ts --",
    "mobile:shots": "npm run data && vite-node scripts/mobile-shots.ts --",
    "ui:check": "npm run data && vite-node scripts/ui-check.ts --",
    "replay:check": "npm run data && vite-node scripts/replay-check.ts --",
    "mobile:play": "npm run data && vite-node scripts/mobile-play.ts --",
    "pwa:check": "npm run data && vite-node scripts/pwa-check.ts",
    "perf:probe": "npm run data && vite-node scripts/perf-probe.ts --",
    "perf:zoom": "npm run data && vite-node scripts/zoom-probe.ts --",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "circular": "madge --circular --extensions ts,tsx packages/engine/src packages/ai/src packages/art/src packages/online/src apps/web/src",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "madge": "^8.0.0",
    "nostr-tools": "^2.25.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.21",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  }
}
